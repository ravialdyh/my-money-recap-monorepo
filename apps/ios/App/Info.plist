<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The realm's ios client redirects to mymoneyrecap://auth/callback (infra/compose/README.md). The same
	     scheme also carries a magic link, mymoneyrecap://magic?lt=..., and a universal link joins it once a
	     domain exists; both reach the one incoming-link handler, as the UI test's launch argument does. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.mymoneyrecap.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mymoneyrecap</string>
			</array>
		</dict>
	</array>
	<!-- Local Compose is plain HTTP: on localhost from the simulator, and on the Mac's LAN address from a
	     physical device (MMR_ISSUER / MMR_BFF_URL). NSAllowsLocalNetworking covers both (unqualified hosts
	     and private addresses). The laptop stack keeps plain HTTP and TLS arrives only on the VM, where
	     Nginx terminates it (ARCHITECTURE A7), so this exception stays for the development stack. -->
	<!-- The two typefaces of the design system (tokens.json font.family), from github.com/google/fonts under the
	     SIL Open Font License, whose text ships beside them in Resources/Fonts. Each is one variable font. -->
	<key>UIAppFonts</key>
	<array>
		<string>Fredoka.ttf</string>
		<string>Nunito.ttf</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
