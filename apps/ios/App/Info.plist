<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The realm's ios client redirects to mymoneyrecap://auth/callback (infra/compose/README.md); a universal link replaces it in slice 3. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.mymoneyrecap.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mymoneyrecap</string>
			</array>
		</dict>
	</array>
	<!-- Local Compose is plain HTTP: on localhost from the simulator, and on the Mac's LAN address from a
	     physical device (MMR_ISSUER / MMR_BFF_URL). NSAllowsLocalNetworking covers the LAN case; slice 3
	     removes it when Nginx terminates TLS (ARCHITECTURE A9). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
