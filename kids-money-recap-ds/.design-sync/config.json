  "dtsPropsFor": {
    "Icon": "  /** Which glyph to draw. The eight Category glyphs (`snacks`/`games`/`toys`/`rides`/`clothes`/`bills`/`gifts`/`other`) and `paw`/`droplet`/`lemon` are 16px filled glyphs for IconWell; `share`/`settings`/`chevron`/`plus` are 20px stroked; `sparkle` is decorative; `piggy` is the 64x30 progress-bar marker. */\n  name: \"paw\" | \"droplet\" | \"lemon\" | \"share\" | \"sparkle\" | \"snacks\" | \"games\" | \"toys\" | \"rides\" | \"clothes\" | \"bills\" | \"gifts\" | \"other\" | \"settings\" | \"chevron\" | \"plus\" | \"piggy\";\n  /** Square size in px. Ignored by the marker (`piggy`). Defaults: 16 for filled glyphs, 20 for stroked ones. */\n  size?: number;\n  /** SVG fill. Category and well glyphs default to their own palette token; stroked glyphs use currentColor. */\n  fill?: string;\n  className?: string;\n  style?: React.CSSProperties;"
  },
