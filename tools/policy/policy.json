{
  "max_lines": 300,
  "max_doc_chars": 255,
  "comment_policy_extensions": [
    ".go",
    ".swift",
    ".ts",
    ".tsx",
    ".js",
    ".mjs"
  ],
  "comment_policy_roots": [
    "apps/",
    "packages/",
    "my-money-recap-ds/src/",
    "my-money-recap-ds/scripts/"
  ],
  "line_cap_extensions": [
    ".go",
    ".swift",
    ".ts",
    ".tsx",
    ".js",
    ".mjs",
    ".py",
    ".sh",
    ".css",
    ".proto",
    ".sql",
    ".yaml",
    ".yml"
  ],
  "generated_markers": [
    "Code generated by",
    "@generated",
    "DO NOT EDIT",
    "Do not edit by hand"
  ],
  "exclude": [
    "my-money-recap/**",
    "my-money-recap-ds/.design-sync/**",
    "docs/**"
  ]
}
