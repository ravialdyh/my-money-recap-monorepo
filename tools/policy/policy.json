{
  "max_lines": 300,
  "max_doc_chars": 255,
  "comment_policy_extensions": [".go", ".swift", ".ts", ".tsx", ".js", ".mjs"],
  "comment_policy_roots": ["apps/", "packages/", "my-money-recap-ds/src/", "my-money-recap-ds/scripts/"],
  "line_cap_extensions": [".go", ".swift", ".ts", ".tsx", ".js", ".mjs", ".py", ".sh", ".css", ".proto", ".sql", ".yaml", ".yml"],
  "generated_markers": ["Code generated by", "@generated", "DO NOT EDIT", "Do not edit by hand"],
  "exclude": [
    "apps/backend/gen/**",
    "packages/contract/swift/Sources/**",
    "apps/ios/DesignSystem/Tokens.swift",
    "apps/ios/**/*.xcodeproj/**",
    "apps/ios/**/xcuserdata/**",
    "my-money-recap-ds/src/styles/css.generated.ts",
    "my-money-recap-ds/src/assets/illustrations.ts",
    "my-money-recap-ds/src/tokens/tokens.json",
    "my-money-recap-ds/.design-sync/**",
    "my-money-recap/**",
    "infra/compose/keycloak/mmr-realm.json",
    "docs/**",
    "**/package-lock.json",
    "**/Package.resolved",
    "**/*.md"
  ]
}
