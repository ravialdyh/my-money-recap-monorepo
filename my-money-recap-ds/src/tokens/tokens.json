{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "My Money Recap design tokens, extracted from the four live artboards (canvas version 1788501827-1d34) and resolved at Checkpoint 1: grounds use the nominal brand hues. Primitives are named by hue; UI references semantic aliases. Motion and pressed/disabled states were adopted at Checkpoint 1 and are not drawn in the static mockups.",

  "palette": {
    "$type": "color",
    "violet": {
      "500": { "$value": "#5B4FE8", "$description": "Brand violet, used for data, chips, accent card" },
      "100": { "$value": "#EFE9FF", "$description": "Violet tint for tracks and icon wells" }
    },
    "yellow": {
      "500": { "$value": "#F7C948", "$description": "Brand yellow, used for data, chips, streak badge" },
      "100": { "$value": "#FFF3CC", "$description": "Yellow tint for tracks" }
    },
    "coral": {
      "500": { "$value": "#F0665A", "$description": "Brand coral, used for data, eyebrows, pills" },
      "100": { "$value": "#FFE3E0", "$description": "Coral tint. The only coral tint; #FFD6D1 and #FFE3EA were consolidated into it" }
    },
    "green": {
      "500": { "$value": "#3DAA6A", "$description": "Brand green, used for data" },
      "100": { "$value": "#C9F0D6", "$description": "Green tint for chips and tracks" }
    },
    "gold": {
      "500": { "$value": "#E8A317", "$description": "Coin ring, Hustler archetype, lemon icon, Gifts category" },
      "100": { "$value": "#FDEFD0", "$description": "Gold tint for the Gifts track and well. Derived to match the lightness of the other 100s" }
    },
    "rust": {
      "500": { "$value": "#C96A3B", "$description": "Squirrel archetype, Other category" },
      "100": { "$value": "#F7E0D3", "$description": "Rust tint for the Other track and well. Derived to match the lightness of the other 100s" }
    },
    "sky": {
      "500": { "$value": "#3BA6F5", "$description": "Fifth hue, added at Checkpoint 1. Derived in oklch (L 0.70, C 0.15, h 245) to sit between coral and green. Supporting colour only, never a ground" },
      "100": { "$value": "#DFF3FF", "$description": "Car-wash icon well" }
    },
    "ink": {
      "900": { "$value": "#1E1B3A", "$description": "Primary ink, inverse surfaces" },
      "500": { "$value": "#6B6890", "$description": "Secondary text" },
      "100": { "$value": "#EFECF7", "$description": "Row divider" }
    },
    "white": { "$value": "#FFFFFF" }
  },

  "color": {
    "$type": "color",
    "ground": {
      "recap": { "$value": "{palette.violet.500}", "$description": "Cover / overview screens" },
      "earning": { "$value": "{palette.yellow.500}", "$description": "Income, chores, streaks. Only ground that takes dark text" },
      "goal": { "$value": "{palette.coral.500}", "$description": "Goals and spending" },
      "personality": { "$value": "{palette.green.500}", "$description": "Archetype / share screen" }
    },
    "surface": {
      "card": { "$value": "{palette.white}" },
      "card-accent": { "$value": "{palette.violet.500}", "$description": "Second card on a light ground (streak card)" },
      "chip-on-ground": { "$value": "{palette.white}" },
      "chip-inverse": { "$value": "{palette.ink.900}" },
      "chip-highlight": { "$value": "{palette.yellow.500}" },
      "button-primary": { "$value": "{palette.ink.900}" },
      "button-secondary": { "$value": "{palette.white}", "$description": "White pill with ink label, for the second action on a ground (e.g. See last month)" },
      "well-violet": { "$value": "{palette.violet.100}" },
      "well-sky": { "$value": "{palette.sky.100}" },
      "well-coral": { "$value": "{palette.coral.100}" },
      "well-yellow": { "$value": "{palette.yellow.100}" },
      "well-green": { "$value": "{palette.green.100}" },
      "well-gold": { "$value": "{palette.gold.100}" },
      "well-rust": { "$value": "{palette.rust.100}" },
      "well-ink": { "$value": "{palette.ink.100}" },
      "track-coral": { "$value": "{palette.coral.100}" },
      "track-violet": { "$value": "{palette.violet.100}" },
      "track-yellow": { "$value": "{palette.yellow.100}" },
      "track-green": { "$value": "{palette.green.100}" },
      "track-sky": { "$value": "{palette.sky.100}" },
      "track-gold": { "$value": "{palette.gold.100}" },
      "track-rust": { "$value": "{palette.rust.100}" },
      "track-ink": { "$value": "{palette.ink.100}" },
      "sheet": { "$value": "{palette.white}", "$description": "Bottom-sheet and full-surface screens (Log a spend, Settings). radius.card on the top corners only" },
      "scrim": { "$value": "rgba(30, 27, 58, 0.4)", "$description": "Dimming layer behind a Sheet" },
      "field": { "$value": "{palette.ink.100}", "$description": "TextField / AmountField inner surface on a white card" },
      "banner": { "$value": "{palette.coral.500}", "$description": "Target Warning banner card" },
      "toggle-on": { "$value": "{palette.violet.500}" },
      "toggle-off": { "$value": "{palette.ink.100}" },
      "divider": { "$value": "{palette.ink.100}" }
    },
    "text": {
      "primary": { "$value": "{palette.ink.900}" },
      "secondary": { "$value": "{palette.ink.500}", "$description": "AA on white at 14px and above only" },
      "on-ground": { "$value": "{palette.white}", "$description": "Large text only on coral and green grounds" },
      "on-ground-muted": { "$value": "rgba(255, 255, 255, 0.85)" },
      "on-ground-dark": { "$value": "{palette.ink.900}", "$description": "Text on the yellow ground" },
      "on-inverse": { "$value": "{palette.white}" },
      "accent-coral": { "$value": "{palette.coral.500}", "$description": "Coloured eyebrow, e.g. THE SPLURGE" }
    },
    "data": {
      "earned": { "$value": "{palette.yellow.500}" },
      "saved": { "$value": "{palette.green.500}" },
      "spent": { "$value": "{palette.coral.500}" },
      "$description-categories": "The eight fixed Spend Categories (PRD D20). Snacks, Games and Toys keep the hues observed on the Goal artboard; the other five were added so CategoryBar can colour all eight. No two categories share a hue.",
      "category-snacks": { "$value": "{palette.coral.500}" },
      "category-games": { "$value": "{palette.violet.500}" },
      "category-toys": { "$value": "{palette.yellow.500}" },
      "category-rides": { "$value": "{palette.sky.500}" },
      "category-clothes": { "$value": "{palette.green.500}" },
      "category-bills": { "$value": "{palette.ink.500}" },
      "category-gifts": { "$value": "{palette.gold.500}" },
      "category-other": { "$value": "{palette.rust.500}" },
      "streak-active": { "$value": "{palette.yellow.500}" },
      "streak-inactive": { "$value": "rgba(255, 255, 255, 0.28)" },
      "chip-earned": { "$value": "{palette.yellow.500}" },
      "chip-saved": { "$value": "{palette.green.100}" },
      "chip-spent": { "$value": "{palette.coral.100}" }
    },
    "archetype": {
      "squirrel": { "$value": "{palette.rust.500}" },
      "hustler": { "$value": "{palette.gold.500}" },
      "treat-yourself": { "$value": "{palette.coral.500}" },
      "slow-burner": { "$value": "{palette.violet.500}" }
    },
    "indicator": {
      "page-active-on-ground": { "$value": "{palette.white}" },
      "page-inactive-on-ground": { "$value": "rgba(255, 255, 255, 0.45)" },
      "page-active-on-light": { "$value": "{palette.ink.900}" },
      "page-inactive-on-light": { "$value": "rgba(30, 27, 58, 0.35)" }
    },
    "state": {
      "$description": "Adopted at Checkpoint 1: one rule each for pressed and disabled. Only the selected states were drawn in the mockups.",
      "selected-ring": { "$value": "{palette.white}", "$description": "Observed on the Squirrel archetype pill" },
      "focus-ring": { "$value": "{palette.violet.500}", "$description": "2px violet ring on a focused TextField or AmountField inside a white card" },
      "invalid-ring": { "$value": "{palette.coral.500}", "$description": "2px coral ring on a field that failed validation" },
      "pressed-lightness-delta": { "$value": "-8%", "$type": "dimension", "$description": "Adopted: same hue, oklch lightness minus 8%, with scale 0.97 over 120ms" },
      "disabled-opacity": { "$value": 0.4, "$type": "number", "$description": "Adopted" },
      "unselected-opacity": { "$value": 0.6, "$type": "number", "$description": "Observed on unselected archetype pills" },
      "row-pressed-wash": { "$value": "rgba(30, 27, 58, 0.04)", "$description": "Adopted for data rows" }
    }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Fredoka", "Arial Rounded MT Bold", "Nunito", "sans-serif"] },
      "text": { "$value": ["Nunito", "Trebuchet MS", "Segoe UI", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "display-bold": { "$value": 700 },
      "display-semibold": { "$value": 600 },
      "text-extrabold": { "$value": 800 },
      "text-bold": { "$value": 700 }
    }
  },

  "type": {
    "$type": "typography",
    "display-xl": { "$value": { "fontFamily": "{font.family.display}", "fontWeight": 700, "fontSize": "80px", "lineHeight": 1.0, "letterSpacing": "-0.02em" }, "$description": "Hero number" },
    "display-l": { "$value": { "fontFamily": "{font.family.display}", "fontWeight": 700, "fontSize": "68px", "lineHeight": 0.98, "letterSpacing": "-0.02em" }, "$description": "Archetype name" },
    "headline-l": { "$value": { "fontFamily": "{font.family.display}", "fontWeight": 700, "fontSize": "48px", "lineHeight": 1.02, "letterSpacing": "-0.01em" }, "$description": "Cover headline, 2 lines" },
    "headline-m": { "$value": { "fontFamily": "{font.family.display}", "fontWeight": 700, "fontSize": "40px", "lineHeight": 1.04, "letterSpacing": "-0.01em" }, "$description": "Screen headline, 2 lines" },
    "headline-m-compact": { "$value": { "fontFamily": "{font.family.display}", "fontWeight": 700, "fontSize": "36px", "lineHeight": 1.04, "letterSpacing": "-0.01em" }, "$description": "Screen headline when 3 lines are unavoidable" },
    "stat-badge": { "$value": { "fontFamily": "{font.family.display}", "fontWeight": 700, "fontSize": "30px", "lineHeight": 1.0 } },
    "title-m": { "$value": { "fontFamily": "{font.family.display}", "fontWeight": 600, "fontSize": "20px", "lineHeight": 1.1 } },
    "title-s": { "$value": { "fontFamily": "{font.family.display}", "fontWeight": 600, "fontSize": "18px", "lineHeight": 1.1 } },
    "body-m": { "$value": { "fontFamily": "{font.family.text}", "fontWeight": 700, "fontSize": "16px", "lineHeight": 1.4 } },
    "body-s": { "$value": { "fontFamily": "{font.family.text}", "fontWeight": 700, "fontSize": "14px", "lineHeight": 1.4 } },
    "label-m": { "$value": { "fontFamily": "{font.family.text}", "fontWeight": 800, "fontSize": "14px", "lineHeight": 1.2 } },
    "label-s": { "$value": { "fontFamily": "{font.family.text}", "fontWeight": 800, "fontSize": "13px", "lineHeight": 1.2 } },
    "caption-upper": { "$value": { "fontFamily": "{font.family.text}", "fontWeight": 800, "fontSize": "12px", "lineHeight": 1.2, "letterSpacing": "0.08em", "textTransform": "uppercase" } },
    "caption-pill": { "$value": { "fontFamily": "{font.family.text}", "fontWeight": 800, "fontSize": "10px", "lineHeight": 1.2, "letterSpacing": "0.02em" } },
    "caption-unit": { "$value": { "fontFamily": "{font.family.text}", "fontWeight": 800, "fontSize": "9px", "lineHeight": 1.0, "letterSpacing": "0.1em", "textTransform": "uppercase" } }
  },

  "space": {
    "$type": "dimension",
    "$description": "4px base with a 2px half-step. Source values 5, 7, 9, 10, 18, 20 are fitting artefacts to round on the next build.",
    "1": { "$value": "4px" },
    "2": { "$value": "6px" },
    "3": { "$value": "8px" },
    "4": { "$value": "12px" },
    "5": { "$value": "14px" },
    "6": { "$value": "16px" },
    "7": { "$value": "22px", "$description": "Card inset" },
    "8": { "$value": "24px", "$description": "Screen horizontal inset" },
    "9": { "$value": "28px", "$description": "Screen bottom inset" },
    "10": { "$value": "56px", "$description": "Screen top inset" },
    "overlap": { "$value": "44px", "$description": "Illustration hang into the card below (source: 42 and 46)" },
    "card-inset-under-illustration": { "$value": "56px", "$description": "Card top padding when an illustration overlaps (source: 54 and 60)" }
  },

  "radius": {
    "$type": "dimension",
    "card": { "$value": "28px" },
    "inset": { "$value": "16px", "$description": "A block nested inside a card: the InlineError message, the DataRow/ListRow press wash. Added 2026-09-08 for PRD 13's InlineError; before it both were spelled as space steps, which hid them from this scale" },
    "pill": { "$value": "999px" }
  },

  "size": {
    "$type": "dimension",
    "screen-width": { "$value": "390px" },
    "screen-height": { "$value": "844px" },
    "button-height": { "$value": "52px" },
    "streak-badge": { "$value": "64px" },
    "icon-well": { "$value": "30px" },
    "icon-glyph": { "$value": "16px" },
    "icon-button": { "$value": "20px" },
    "track-goal": { "$value": "22px" },
    "track-compare": { "$value": "18px" },
    "track-category": { "$value": "16px" },
    "streak-dot": { "$value": "12px" },
    "page-dot": { "$value": "6px" },
    "page-dot-active-width": { "$value": "22px" },
    "status-dot": { "$value": "8px" },
    "touch-target-min": { "$value": "44px", "$description": "Met by the tappable Chip and ArchetypePill variants via a transparent ::before, so the drawn pill keeps its size" },
    "field-height": { "$value": "52px", "$description": "TextField and AmountField, matching button-height" },
    "sheet-handle-width": { "$value": "36px" },
    "sheet-handle-height": { "$value": "5px" },
    "toggle-width": { "$value": "51px", "$description": "iOS switch proportions" },
    "toggle-height": { "$value": "31px" },
    "toggle-knob": { "$value": "27px" },
    "slider-knob": { "$value": "28px", "$description": "Rides the goal-height track, so it stands 3px proud on each side" },
    "avatar-grid-cell": { "$value": "68px", "$description": "Avatar in the onboarding 3x2 grid" },
    "avatar-inline": { "$value": "56px", "$description": "Avatar beside the Home greeting" }
  },

  "border": {
    "divider": { "$type": "border", "$value": { "color": "{palette.ink.100}", "width": "1px", "style": "solid" } },
    "selected-ring": { "$type": "shadow", "$value": { "color": "{palette.white}", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "2px" } }
  },

  "elevation": {
    "$description": "No drop shadows anywhere. Depth comes from overlap and ground-versus-card colour.",
    "none": { "$type": "shadow", "$value": "none" }
  },

  "motion": {
    "$description": "Adopted at Checkpoint 1. Not drawn in the static mockups; applies to the built app.",
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0.8, 0.2, 1] },
      "press": { "$value": [0, 0, 0.2, 1] }
    },
    "duration": {
      "$type": "duration",
      "press": { "$value": "120ms" },
      "enter-screen": { "$value": "320ms" },
      "reveal-bar": { "$value": "600ms" },
      "reveal-number": { "$value": "800ms" },
      "stagger": { "$value": "80ms" },
      "reduced": { "$value": "150ms", "$description": "Fade only, when prefers-reduced-motion" }
    },
    "press-scale": { "$type": "number", "$value": 0.97 },
    "enter-offset": { "$type": "dimension", "$value": "24px" }
  },

  "asset": {
    "illustration": {
      "$description": "Flat vector, no outlines, one darker shading tone per hue, white glint dots, transparent WebP at 2x display size. Style block in illustration-prompts.md.",
      "cover-display-width": { "$type": "dimension", "$value": "310px" },
      "lemonade-display-width": { "$type": "dimension", "$value": "200px" },
      "vending-display-width": { "$type": "dimension", "$value": "168px" },
      "squirrel-display-width": { "$type": "dimension", "$value": "340px" }
    }
  }
}
