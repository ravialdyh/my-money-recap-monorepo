# SwiftFormat owns every formatting decision. SwiftLint (.swiftlint.yml) owns correctness and repeats
# none of it. Both cover the same files: the app, plus the contract package's hand-written manifest.
--swiftversion 5.9
--exclude apps/ios/DesignSystem/Tokens.swift,packages/contract/swift/Sources,**/.build,**/build

--indent 4
--maxwidth 120
--wraparguments before-first
--wrapparameters before-first
--wrapcollections preserve
--closingparen balanced
--commas always
--trimwhitespace always
--stripunusedargs closure-only
--self remove
--importgrouping testable-bottom
--disable redundantReturn,blankLinesAtStartOfScope
