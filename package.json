{
  "name": "kids-money-tracker",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for Kids Money Recap: design source, design system, apps and infrastructure.",
  "workspaces": [
    "kids-money-recap-ds",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:tokens": "npm run build:tokens -w @kids-money-recap/ui",
    "build:assets": "npm run build:assets -w @kids-money-recap/ui"
  },
  "engines": {
    "node": ">=20"
  }
}
