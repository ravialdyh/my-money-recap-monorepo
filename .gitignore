# macOS
.DS_Store

# Node
node_modules/
npm-debug.log*

# 4K illustration originals (~58 MB). The shipped WebP cut-outs in
# my-money-recap/assets/ are committed; these are the raw generator output,
# kept locally and backed up outside git.
my-money-recap/renders/

# Scratch harnesses. Anything named .tmp-* is a throwaway built to measure or
# render something once; none of it belongs in a commit.
.tmp-*

# Screen renders (PNG). Nothing links to an individual one and git would keep them
# forever; export them on demand from the two live canvases linked in
# docs/design/design_handoff_my_money_recap/README.md.
docs/design/**/screens/

# Secrets and keys. Real values live in infra/secrets/ encrypted with SOPS (A13); nothing plain-text is ever committed.
.env
.env.*
!.env.example
*.p8
*.p12
*.pem
*.key
age.key
