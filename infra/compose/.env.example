# Copy to .env (git-ignored) and fill every value. Development-only credentials; never commit them.

# Parallel worktrees on one machine: give each its own project name and host ports (README, "Parallel worktrees").
COMPOSE_PROJECT_NAME=mmr
KEYCLOAK_HOST_PORT=8080
MEMBERS_HOST_PORT=8081
BFF_HOST_PORT=8082
POSTGRES_HOST_PORT=5432
# The host name Keycloak stamps into tokens and the services check. localhost for the simulator; the Mac's
# LAN address (for example 192.168.1.20) when a physical phone signs in (README, "A phone on the LAN").
MMR_HOST=localhost

# Postgres superuser password: initialises the cluster and lets postgres/10-databases.sh connect once.
POSTGRES_PASSWORD=
# One role per database (ARCHITECTURE A9).
KEYCLOAK_DB_PASSWORD=
MEMBERS_DB_PASSWORD=

# Keycloak bootstrap admin; the console is not reachable over plain HTTP from the host (README, "Admin access").
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Filled into keycloak/mmr-realm.json on first boot (${VAR} import placeholders).
TEST_USER_PASSWORD=
BFF_CLIENT_SECRET=
